{
  "name": "opencode-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Notes plugin for OpenCode: curated long-term memory as typed tools (notes.*) and a SolidJS side-panel GUI (./gui-experimental), both over the SQLite notes.db directly.",
  "exports": {
    ".": {
      "import": "./index.ts"
    },
    "./gui-experimental": {
      "import": "./dist/gui-experimental.cjs"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:gui": "tsc --noEmit -p tsconfig.gui.json",
    "gui:build": "vite build",
    "gui:watch": "vite --watch"
  },
  "dependencies": {
    "opencode-shared": "github:HitalloExiled/opencode-shared#d8e1eb78196e0621cf93f5ac8ea2efd38df7d1d6"
  },
  "devDependencies": {
    "@opencode/plugin": "2.2.0",
    "@types/node": "24.12.2",
    "effect": "4.0.1",
    "solid-js": "1.9.18",
    "typescript": "5.8.2",
    "vite": "5.4.17",
    "vite-plugin-solid": "2.11.15",
    "zod": "4.6.7"
  }
}
